RewriteEngine On

# Map sitemap.xml to sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# SEO Landing Pages (e.g. /best-hospital-in-purnea, /best-cardiologist-doctor-in-purnea)
RewriteRule ^best-([a-zA-Z0-9-]+)-in-purnea/?$ seo-landing.php?slug=$1 [L,QSA]

# If the request is not a file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirect to the corresponding .php file if it exists
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# For booking form or other explicit API endpoints
RewriteRule ^api/appointment/slots$ api/get_slots.php [L]
RewriteRule ^api/appointment/book$ api/book_appointment.php [L]
